{
  "manifest_version": 3,
  "key": "",
  "name": "LeetCode CPH Capture",
  "version": "0.2.3",
  "description": "Capture the current LeetCode problem and editor code into VS Code.",
  "permissions": ["activeTab", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://leetcode.cn/*",
    "https://www.leetcode.cn/*",
    "https://leetcode.com/*",
    "https://www.leetcode.com/*",
    "http://127.0.0.1:27121/*"
  ],
  "action": {
    "default_title": "一键带走当前题目和代码"
  },
  "background": {
    "service_worker": "background.js"
  }
}
